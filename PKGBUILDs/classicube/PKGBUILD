pkgname=classicube
pkgver=1.r8920.gd7ee58bdb
pkgrel=1
pkgdesc="Voxel game client compatible with Minecraft Classic"
arch=('x86_64')
url="https://github.com/ClassiCube/ClassiCube"
license=('BSD-3-Clause')
depends=('sdl2')
makedepends=('git' 'libxi')

source=("git+https://github.com/ClassiCube/ClassiCube.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/ClassiCube"

    printf "1.r%s.g%s" \
        "$(git rev-list --count HEAD)" \
        "$(git rev-parse --short HEAD)"
}

build() {
    cd "$srcdir/ClassiCube"
    make linux RELEASE=1
}

package() {
    cd "$srcdir/ClassiCube"

    install -Dm755 ClassiCube "$pkgdir/usr/bin/ClassiCube"
}
